# Modelo de env do main-app (Vite). Copie para `.env` local (nunca commitar).
# Em produção, defina estas variáveis no Netlify:
# Site settings → Environment variables (aplica em build + deploys).
#
# Como gerar/rotacionar (Google Cloud Console):
# 1. APIs & Services → Credentials → crie/restrinja a API key:
#    Application restrictions → Websites (HTTP referrers) e adicione
#    https://<seu-site>.netlify.app/* (e o domínio final /*).
# 2. OAuth 2.0 Client ID (Web application): Authorized JavaScript origins =
#    https://<seu-site>.netlify.app (e o domínio final).

VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=

# Supabase (01-DATA_CONTRACT + 03-SYNC_PROTOCOL). Anon key é pública (browser).
# Publique via env do Netlify. URL do projeto: https://<ref>.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Monitoramento (Fase 13). Sem DSN = desativado. Crie o projeto em
# https://sentry.io e cole o DSN aqui + nas envs do Netlify.
VITE_SENTRY_DSN=

# Bridge Quantower (04-BRIDGE_V2_SPEC.md). Token gerado no primeiro run do bridge
# (ficará em %LOCALAPPDATA%\QuantowerBridge\token.txt). Copie aqui e para o app.
# Sem o token, TODA rota do bridge responde 401.
VITE_BRIDGE_URL=http://127.0.0.1:8787
VITE_BRIDGE_TOKEN=

# Preços (P1/A7). Brapi sem token tem rate-limit baixo; com token, limite maior.
# Opcional — sem token o app usa cooldown + cache (nunca quebra).
# Crie em https://brapi.dev/dashboard e cole aqui + nas envs do Netlify.
VITE_BRAPI_TOKEN=

# Ações US (A6). URL do proxy Yahoo (default: /.netlify/functions/yahoo-quote).
# Só mude se hospedar o proxy fora do Netlify.
VITE_YAHOO_PROXY=

# Push (P2). Gere com `npx -y web-push generate-vapid-keys`.
# Sem a chave pública, o toggle de push em Settings mostra "sem chave VAPID".
# Ver supabase/README-push.md (secrets da Edge Function + deploy + cron).
VITE_VAPID_PUBLIC_KEY=

